# Marginalia Environment Configuration
# Copy to .env and fill in values

# ==========================================
# Database (PostgreSQL + pgvector)
# ==========================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=marginalia
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_SSL_MODE=Prefer

# Connection string (alternative to individual settings above)
# DATABASE_URL=Host=localhost;Port=5432;Database=marginalia;Username=postgres;Password=postgres;SSL Mode=Prefer

# ==========================================
# Vector Store (pgvector)
# ==========================================
VECTOR_STORE_CONNECTION_STRING=Host=localhost;Port=5432;Database=marginalia;Username=postgres;Password=postgres
VECTOR_DIMENSIONS=768

# ==========================================
# Redis (optional - for caching embeddings)
# ==========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# REDIS_CONNECTION_STRING=localhost:6379

# ==========================================
# Semantic Kernel / LLM Configuration
# ==========================================

# --- Ollama (local) ---
OLLAMA_ENDPOINT=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.2
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# --- Groq (API) ---
# GROQ_API_KEY=
# GROQ_CHAT_MODEL=llama-3.1-70b-versatile

# --- Gemini (API) ---
# GEMINI_API_KEY=
# GEMINI_CHAT_MODEL=gemini-1.5-flash
# GEMINI_EMBEDDING_MODEL=text-embedding-004

# Active provider: "Ollama" | "Groq" | "Gemini"
LLM_PROVIDER=Ollama

# ==========================================
# Backend API
# ==========================================
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5000
API_BASE_URL=http://localhost:5000

# CORS - extension origin (update for production)
CORS_ALLOWED_ORIGINS=chrome-extension://*,http://localhost:5173

# ==========================================
# Session Configuration
# ==========================================
SESSION_TTL_MINUTES=60
SESSION_CLEANUP_INTERVAL_MINUTES=15

# ==========================================
# Performance / Limits
# ==========================================
MAX_PAGE_WORDS=10000
MAX_CHUNK_SIZE=512
CHUNK_OVERLAP=50
MAX_EMBEDDING_BATCH_SIZE=100
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=3

# ==========================================
# Observability
# ==========================================
SERILOG_MINIMUM_LEVEL=Information
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=marginalia-api

# ==========================================
# Extension (Vite dev server)
# ==========================================
VITE_API_BASE_URL=http://localhost:5000